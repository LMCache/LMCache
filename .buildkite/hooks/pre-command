#!/usr/bin/env bash
set -euo pipefail

# Merge before Bash opens entrypoints or setup scripts from the PR checkout.
# shellcheck source=.buildkite/k3_tests/common_scripts/helpers.sh
source "$(dirname "${BASH_SOURCE[0]}")/../k3_tests/common_scripts/helpers.sh"
merge_pr_base_branch origin

# Keep this job's checkout stable when setup scripts call the helper again.
export LMCACHE_PR_BASE_MERGE=never
