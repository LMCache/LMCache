ARG XPU_BASE_IMAGE
FROM ${XPU_BASE_IMAGE}

USER root
COPY .buildkite/k3_tests/xpu/install_xpu_dpcpp_compiler.sh /tmp/install_xpu_dpcpp_compiler.sh

RUN apt-get update -qq -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends jq \
    && PYTHON="$(command -v python3)" bash /tmp/install_xpu_dpcpp_compiler.sh \
    && python3 -m pip install uv \
    && jq --version

ENV BASH_ENV=/opt/intel/oneapi/setvars.sh

RUN --mount=type=bind,source=requirements,target=/tmp/requirements \
    uv pip install --no-cache \
        -r /tmp/requirements/common.txt \
        -r /tmp/requirements/test.txt \
        'lm-eval[api]' pandas matplotlib
