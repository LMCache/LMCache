#include <sycl/sycl.hpp>
#include <torch/all.h>

// ---------- Utility / pointer helper ----------
// NOTE: In SYCL environment you may need to map host pinned pointers to USM pointers.
// Here we simply return the raw data_ptr() as in original code. If you need device-mapped
// host pointer, replace this implementation with proper SYCL-USM registration.
template <typename T, typename TENSOR_TYPE>
T* get_kernel_ptr(TENSOR_TYPE& tensor) {
  // We assume tensor.data_ptr() points to memory that can be accessed by device (or has been
  // prepared appropriately by the caller e.g., using USM).
  return static_cast<T*>(tensor.data_ptr());
}

// ---------- SYCL kernels and host wrappers ----------

namespace lmc {

template <typename scalar_t> class LoadReshapeKernel;
template <typename scalar_t> class ReshapeCacheBackKernel;
template <typename scalar_t, bool USE_MLA> class SingleLayerTransferKernel;
template <typename scalar_t> class SingleLayerTransferSGLKernel;
template <typename scalar_t, bool USE_MLA> class MultiLayerTransferKernel;
template <typename scalar_t, bool DIRECTION> class LoadReshapeMultiLayerKernel;
template <typename scalar_t, bool DIRECTION> class LoadReshapeMultiLayerUnilateralKernel;

// Helper inline functions translated from __device__ helpers
inline int64_t page_buffer_offset(
    const int k_or_v, const int token_idx, const int scalar_offset,
    const int scalars_per_token, const int page_buffer_size) {
  return (int64_t)k_or_v * page_buffer_size * scalars_per_token +
         (int64_t)token_idx * scalars_per_token + scalar_offset;
}

inline int64_t page_buffer_offset_unilateral(
    const int token_idx, const int scalar_offset, const int scalars_per_token) {
  return (int64_t)token_idx * scalars_per_token + scalar_offset;
}

inline int64_t key_value_offset(const int k_or_v, const int layer_idx,
                                const int token_idx, const int scalar_offset,
                                const int scalars_per_token, const int num_tokens,
                                const int num_layers) {
  return (int64_t)k_or_v * num_layers * num_tokens * scalars_per_token +
         (int64_t)layer_idx * num_tokens * scalars_per_token +
         (int64_t)token_idx * scalars_per_token + scalar_offset;
}

// ----------------- load_and_reshape_flash_kernel -----------------
template <typename scalar_t>
void launch_load_and_reshape_flash_kernel(
    sycl::queue &q,
    scalar_t* key_value,  // [num_tokens, num_heads, head_size] (kernel-visible)
    const scalar_t* key_cache,    // [num_blocks, block_size, num_heads, head_size]
    const scalar_t* value_cache,  // [num_blocks, block_size, num_heads, head_size]
    const int64_t* slot_mapping,  // [num_tokens]
    const int block_stride_in_64bit, const int key_value_stride,
    const int num_heads, const int head_size_in_64bit, const int block_size,
    const int key_layer_offset, const int value_layer_offset,
    const int num_tokens) {

  // We'll launch with nd_range: one work-group per token, local size = threads per block
  int n = num_heads * head_size_in_64bit;
  int local = std::min(n, 128);
  int global = local * num_tokens;

  q.submit([&](sycl::handler &h) {
    h.parallel_for<class LoadReshapeKernel<scalar_t>>(
      sycl::nd_range<1>(sycl::range<1>(global), sycl::range<1>(local)),
      [=](sycl::nd_item<1> it) {
        const int local_idx = it.get_local_id(0);      // threadIdx.x
        const int block_dim = it.get_local_range(0);   // blockDim.x
        const int block_idx = it.get_group(0);         // blockIdx.x (token)
        const int token_idx = block_idx;

        const int64_t slot_idx = slot_mapping[token_idx];
        if (slot_idx < 0) return;

        //sycl::ext::oneapi::experimental::printf("line %d id == %zu local_idx %d block_dim %d\n", __LINE__, it.get_global_id(0), local_idx, block_dim);
        const int64_t block_index = slot_idx / block_size;
        const int64_t block_offset = slot_idx % block_size;
        //sycl::ext::oneapi::experimental::printf("line 85 %d %d %d \n", it.get_global_id(0), local_idx, block_idx);

        for (int i = local_idx; i < n; i += block_dim) {
          const int64_t tgt_key_idx =
              key_layer_offset + (int64_t)token_idx * key_value_stride + i;
          const int64_t tgt_value_idx =
              value_layer_offset + (int64_t)token_idx * key_value_stride + i;

          //sycl::ext::oneapi::experimental::printf("line %d %d %d %d %d %d %lld %lld\n", __LINE__, key_layer_offset, token_idx, key_value_stride, i, value_layer_offset, tgt_key_idx, tgt_value_idx);
          const int head_idx = i / head_size_in_64bit;
          const int head_offset = i % head_size_in_64bit;
          const int64_t src_key_value_idx =
              (int64_t)block_index * block_stride_in_64bit +
              (int64_t)block_offset * num_heads * head_size_in_64bit +
              head_idx * head_size_in_64bit + head_offset;
          //sycl::ext::oneapi::experimental::printf("line %d %lld\n", __LINE__, src_key_value_idx);

          scalar_t tgt_key = key_cache[src_key_value_idx];
          scalar_t tgt_value = value_cache[src_key_value_idx];
          //sycl::ext::oneapi::experimental::printf("line %d\n", __LINE__);

          //sycl::ext::oneapi::experimental::printf("line %d %d %d %d %d %d %lld %lld\n", __LINE__, key_layer_offset, token_idx, key_value_stride, i, value_layer_offset, tgt_key_idx, tgt_value_idx);
          key_value[tgt_key_idx] = tgt_key;
          key_value[tgt_value_idx] = tgt_value;
          //sycl::ext::oneapi::experimental::printf("line %d %d %d %d %d %d %lld %lld\n", __LINE__, key_layer_offset, token_idx, key_value_stride, i, value_layer_offset, tgt_key_idx, tgt_value_idx);
        }
        //sycl::ext::oneapi::experimental::printf("line 111 %d %d %d\n", it.get_global_id(0), local_idx, block_idx);
      });
  });
  q.wait();
}

// ----------------- reshape_and_cache_back_flash_kernel -----------------
template <typename scalar_t>
void launch_reshape_and_cache_back_flash_kernel(
    sycl::queue &q,
    const scalar_t* key_value,  // [num_tokens, num_heads, head_size]
    scalar_t* key_cache,    // [num_blocks, block_size, num_heads, head_size]
    scalar_t* value_cache,  // [num_blocks, block_size, num_heads, head_size]
    const int64_t* slot_mapping,  // [num_tokens]
    const int block_stride_in_64bit, const int key_value_stride,
    const int num_heads, const int head_size_in_64bit, const int block_size,
    const int key_layer_offset, const int value_layer_offset,
    const int num_tokens) {

  int n = num_heads * head_size_in_64bit;
  int local = std::min(n, 128);
  int global = local * num_tokens;

  q.submit([&](sycl::handler &h) {
    h.parallel_for<class ReshapeCacheBackKernel<scalar_t>>(
      sycl::nd_range<1>(sycl::range<1>(global), sycl::range<1>(local)),
      [=](sycl::nd_item<1> it) {
        const int local_idx = it.get_local_id(0);
        const int block_dim = it.get_local_range(0);
        const int block_idx = it.get_group(0);
        const int token_idx = block_idx;

        const int64_t slot_idx = slot_mapping[token_idx];
        if (slot_idx < 0) return;

        const int64_t block_index = slot_idx / block_size;
        const int64_t block_offset = slot_idx % block_size;

        for (int i = local_idx; i < n; i += block_dim) {
          const int64_t tgt_key_idx =
              key_layer_offset + (int64_t)token_idx * key_value_stride + i;
          const int64_t tgt_value_idx =
              value_layer_offset + (int64_t)token_idx * key_value_stride + i;

          const int head_idx = i / head_size_in_64bit;
          const int head_offset = i % head_size_in_64bit;
          const int64_t src_key_value_idx =
              (int64_t)block_index * block_stride_in_64bit +
              (int64_t)block_offset * num_heads * head_size_in_64bit +
              head_idx * head_size_in_64bit + head_offset;

          scalar_t tgt_key = key_value[tgt_key_idx];
          scalar_t tgt_value = key_value[tgt_value_idx];

          key_cache[src_key_value_idx] = tgt_key;
          value_cache[src_key_value_idx] = tgt_value;
        }
      });
  });
  q.wait();
}

// ----------------- single_layer_kv_transfer_kernel -----------------
// direction: true = GPU to LMCache (PagedBuffer -> LMCache), false = LMCache to GPU
template <typename scalar_t, bool USE_MLA>
void launch_single_layer_kv_transfer_kernel(
    sycl::queue &q,
    scalar_t* lmc_key_value_cache,   // device-visible
    scalar_t* vllm_key_value_cache,  // device-visible
    const int64_t* slot_mapping,
    const int vllm_block_key_stride_in_64bit, const int vllm_value_offset,
    const int lmc_stride, const int lmc_value_offset, const int num_heads,
    const int head_size_in_64bit, const int block_size, const bool direction,
    const int num_tokens) {

  int n = num_heads * head_size_in_64bit;
  int local = std::min(n, 128);
  int global = local * num_tokens;

  q.submit([&](sycl::handler &h) {
    h.parallel_for<class SingleLayerTransferKernel<scalar_t, USE_MLA>>(
      sycl::nd_range<1>(sycl::range<1>(global), sycl::range<1>(local)),
      [=](sycl::nd_item<1> it) {
        const int local_idx = it.get_local_id(0);
        const int block_dim = it.get_local_range(0);
        const int block_idx = it.get_group(0);
        const int token_idx = block_idx;

        const int64_t slot_idx = slot_mapping[token_idx];
        if (slot_idx < 0) return;

        const int64_t block_index = slot_idx / block_size;
        const int64_t block_offset = slot_idx % block_size;

        for (int i = local_idx; i < n; i += block_dim) {
          const int64_t lmc_key_idx = (int64_t)token_idx * lmc_stride + i;

          const int head_idx = i / head_size_in_64bit;
          const int head_offset = i % head_size_in_64bit;
          const int64_t vllm_key_idx =
              (int64_t)block_index * vllm_block_key_stride_in_64bit +
              (int64_t)block_offset * num_heads * head_size_in_64bit +
              head_idx * head_size_in_64bit + head_offset;

          if (direction) {
            // GPU to LMCache
            lmc_key_value_cache[lmc_key_idx] = vllm_key_value_cache[vllm_key_idx];
            if (!USE_MLA) {
            //if constexpr (!USE_MLA) {
              const int64_t lmc_value_idx = lmc_key_idx + lmc_value_offset;
              const int64_t vllm_value_idx = vllm_key_idx + vllm_value_offset;
              lmc_key_value_cache[lmc_value_idx] =
                  vllm_key_value_cache[vllm_value_idx];
            }
          } else {
            // LMCache to GPU
            vllm_key_value_cache[vllm_key_idx] = lmc_key_value_cache[lmc_key_idx];
            if (!USE_MLA) {
            //if constexpr (!USE_MLA) {
              const int64_t lmc_value_idx = lmc_key_idx + lmc_value_offset;
              const int64_t vllm_value_idx = vllm_key_idx + vllm_value_offset;
              vllm_key_value_cache[vllm_value_idx] =
                  lmc_key_value_cache[lmc_value_idx];
            }
          }
        }
      });
  });
  q.wait();
}

// ----------------- single_layer_kv_transfer_sgl_kernel -----------------
template <typename scalar_t>
void launch_single_layer_kv_transfer_sgl_kernel(
    sycl::queue &q,
    scalar_t* lmc_key_value_cache,
    scalar_t* sgl_key_cache,
    scalar_t* sgl_value_cache,
    const int64_t* slot_mapping,
    const int block_stride_in_64bit, const int lmc_stride,
    const int lmc_value_offset, const int num_heads,
    const int head_size_in_64bit, const int block_size, const bool direction,
    const int num_tokens) {

  int n = num_heads * head_size_in_64bit;
  int local = std::min(n, 128);
  int global = local * num_tokens;

  q.submit([&](sycl::handler &h) {
    h.parallel_for<class SingleLayerTransferSGLKernel<scalar_t>>(
      sycl::nd_range<1>(sycl::range<1>(global), sycl::range<1>(local)),
      [=](sycl::nd_item<1> it) {
        const int local_idx = it.get_local_id(0);
        const int block_dim = it.get_local_range(0);
        const int block_idx = it.get_group(0);
        const int token_idx = block_idx;

        const int64_t slot_idx = slot_mapping[token_idx];
        if (slot_idx < 0) return;

        const int64_t block_index = slot_idx / block_size;
        const int64_t block_offset = slot_idx % block_size;

        for (int i = local_idx; i < n; i += block_dim) {
          const int64_t lmc_key_idx = (int64_t)token_idx * lmc_stride + i;
          const int64_t lmc_value_idx = lmc_key_idx + lmc_value_offset;

          const int head_idx = i / head_size_in_64bit;
          const int head_offset = i % head_size_in_64bit;
          const int64_t sgl_key_value_idx =
              (int64_t)block_index * block_stride_in_64bit +
              (int64_t)block_offset * num_heads * head_size_in_64bit +
              head_idx * head_size_in_64bit + head_offset;

          if (direction) {
            lmc_key_value_cache[lmc_key_idx] = sgl_key_cache[sgl_key_value_idx];
            lmc_key_value_cache[lmc_value_idx] = sgl_value_cache[sgl_key_value_idx];
          } else {
            sgl_key_cache[sgl_key_value_idx] = lmc_key_value_cache[lmc_key_idx];
            sgl_value_cache[sgl_key_value_idx] = lmc_key_value_cache[lmc_value_idx];
          }
        }
      });
  });
  q.wait();
}

// ----------------- multi-layer kernels (paged buffer <-> LMCache) -----------------
template <typename scalar_t, bool DIRECTION>
void launch_load_and_reshape_multi_layer_kernel(
    sycl::queue &q,
    scalar_t* key_value,           // [2, num_layer, num_tokens, scalars_per_token]
    scalar_t** paged_buffer_ptrs,  // device pointer to array of pointers per layer
    const int64_t* slot_mapping,
    const int scalars_per_token, const int num_tokens, const int num_layers,
    const int page_buffer_size, const bool use_mla) {

  // We'll launch a 3D grid: (k_or_v, layer_id, token_id) -> map to range<3>
  // SYCL's range ordering: range<3>(D0,D1,D2) with id[0]..id[2]
  int k_or_v = 2;
  if (use_mla) {
    k_or_v = 1;
  }

  int dim0 = k_or_v;
  // If MLA/other variants change k_or_v size outside caller, caller must prepare.
  int global0 = dim0;
  int global1 = num_layers;
  int global2 = num_tokens;

  q.submit([&](sycl::handler &h) {
    h.parallel_for<class LoadReshapeMultiLayerKernel<scalar_t, DIRECTION>>(
      sycl::range<3>(global0, global1, global2),
      [=](sycl::id<3> idx) {
        const int k_or_v = idx[0];
        const int layer_id = idx[1];
        const int token_id = idx[2];
        // Access paged buffer pointer for layer
        scalar_t* paged_ptr = paged_buffer_ptrs[layer_id];
        const int64_t slot_idx = slot_mapping[token_id];
        if (slot_idx < 0) return;

        // We don't have thread-level parallelism here; emulate with a simple for loop.
        // If desired, consider nd_range+local to parallelize scalars_per_token dimension.
        for (int i = 0; i < scalars_per_token; ++i) {
          const int64_t lmcache_offset =
              key_value_offset(k_or_v, layer_id, token_id, i, scalars_per_token, num_tokens, num_layers);
          const int64_t vllm_offset =
              page_buffer_offset(k_or_v, slot_idx, i, scalars_per_token, page_buffer_size);

          if constexpr (DIRECTION) { // 1 paged buffer -> LMCache
            key_value[lmcache_offset] = paged_ptr[vllm_offset];
          } else {
            paged_ptr[vllm_offset] = key_value[lmcache_offset];
          }
        }
      });
  });
  q.wait();
}

template <typename scalar_t, bool DIRECTION>
void launch_load_and_reshape_multi_layer_kernel_unilateral(
    sycl::queue &q,
    scalar_t* key_value,
    scalar_t** paged_buffer_ptrs,  // [num_layers*2]
    const int64_t* slot_mapping,
    const int scalars_per_token, const int num_tokens, const int num_layers,
    const int page_buffer_size, const bool use_mla) {

  int k_or_v = 2;
  if (use_mla) {
    k_or_v = 1;
  }
  int dim0 = k_or_v;
  int global0 = dim0;
  int global1 = num_layers;
  int global2 = num_tokens;

  q.submit([&](sycl::handler &h) {
    h.parallel_for<class LoadReshapeMultiLayerUnilateralKernel<scalar_t, DIRECTION>>(
      sycl::range<3>(global0, global1, global2),
      [=](sycl::id<3> idx) {
        const int k_or_v = idx[0];
        const int layer_id = idx[1];
        const int token_id = idx[2];

        scalar_t* key_ptr = paged_buffer_ptrs[layer_id];
        scalar_t* value_ptr = paged_buffer_ptrs[layer_id + num_layers];

        const int64_t slot_idx = slot_mapping[token_id];
        if (slot_idx < 0) return;

        for (int i = 0; i < scalars_per_token; ++i) {
          const int64_t lmcache_offset =
              key_value_offset(k_or_v, layer_id, token_id, i, scalars_per_token, num_tokens, num_layers);
          const int64_t sgl_offset = page_buffer_offset_unilateral(slot_idx, i, scalars_per_token);

          if (k_or_v == 0) {
            if constexpr (DIRECTION) {
              key_value[lmcache_offset] = key_ptr[sgl_offset];
            } else {
              key_ptr[sgl_offset] = key_value[lmcache_offset];
            }
          } else {
            if constexpr (DIRECTION) {
              key_value[lmcache_offset] = value_ptr[sgl_offset];
            } else {
              value_ptr[sgl_offset] = key_value[lmcache_offset];
            }
          }
        }
      });
  });
  q.wait();
}

} // namespace lmc

// ----------------- Host wrapper functions (signatures kept identical) -----------------
// These functions call the SYCL launchers above. Device selection currently uses sycl::default_selector_v.
// You can change selector to Intel XPU selector if DPC++ supports it in your environment.

void multi_layer_kv_transfer(
    torch::Tensor& key_value,
    const torch::Tensor& key_value_ptrs,
    const torch::Tensor& slot_mapping,
    const torch::Device& paged_memory_device, const int page_buffer_size,
    const bool direction, const bool use_mla) {

  // Map pointers
  int64_t* key_value_ptr = get_kernel_ptr<int64_t, torch::Tensor>(key_value);

  // key_value_ptrs expected to be tensor of device pointers: reinterpret as int64_t**
  int64_t** page_buffer_ptrs = get_kernel_ptr<int64_t*, const torch::Tensor>(const_cast<torch::Tensor&>(key_value_ptrs));

  const int64_t* slot_mapping_ptr =
      get_kernel_ptr<const int64_t, const torch::Tensor>(slot_mapping);

  int num_layers = key_value.size(1);
  int num_tokens = slot_mapping.size(0);
  int num_origin_elements = key_value.size(3);
  int elements_per_qword = 8 / key_value.element_size();
  int num_qwords = num_origin_elements / elements_per_qword;

  // create SYCL queue (selector can be changed to XPU-specific selector)
  sycl::queue q;
  auto device_id = key_value.device().index();
  auto devices = sycl::device::get_devices(sycl::info::device_type::gpu);
  if (device_id >= 0 && device_id < static_cast<int>(devices.size())) {
      q = sycl::queue(devices[device_id]);
  } else {
      q = sycl::queue(sycl::default_selector_v);  // Use default GPU
  } 

  // call corresponding launcher
  if (direction == false) {
    lmc::launch_load_and_reshape_multi_layer_kernel<int64_t, false>(
        q, key_value_ptr, (int64_t**)page_buffer_ptrs, slot_mapping_ptr,
        num_qwords, num_tokens, num_layers, page_buffer_size, use_mla);
  } else {
    lmc::launch_load_and_reshape_multi_layer_kernel<int64_t, true>(
        q, key_value_ptr, (int64_t**)page_buffer_ptrs, slot_mapping_ptr,
        num_qwords, num_tokens, num_layers, page_buffer_size, use_mla);
  }
}

void multi_layer_kv_transfer_unilateral(
    torch::Tensor& key_value,
    const torch::Tensor& key_value_ptrs,
    const torch::Tensor& slot_mapping,
    const torch::Device& paged_memory_device, const int page_buffer_size,
    const bool direction, const bool use_mla) {

  if (use_mla) {
    return multi_layer_kv_transfer(key_value, key_value_ptrs, slot_mapping,
                                   paged_memory_device, page_buffer_size,
                                   direction, use_mla);
  }

  int64_t* key_value_ptr = get_kernel_ptr<int64_t, torch::Tensor>(key_value);
  int64_t** page_buffer_ptrs =
      get_kernel_ptr<int64_t*, const torch::Tensor>(const_cast<torch::Tensor&>(key_value_ptrs));
  const int64_t* slot_mapping_ptr =
      get_kernel_ptr<const int64_t, const torch::Tensor>(slot_mapping);

  int num_layers = key_value.size(1);
  int num_tokens = slot_mapping.size(0);
  int num_origin_elements = key_value.size(3);
  int elements_per_qword = 8 / key_value.element_size();
  int num_qwords = num_origin_elements / elements_per_qword;

  sycl::queue q;
  auto device_id = key_value.device().index();
  auto devices = sycl::device::get_devices(sycl::info::device_type::gpu);
  if (device_id >= 0 && device_id < static_cast<int>(devices.size())) {
      q = sycl::queue(devices[device_id]);
  } else {
      q = sycl::queue(sycl::default_selector_v);  // Use default GPU
  } 

  if (direction == false) {
    lmc::launch_load_and_reshape_multi_layer_kernel_unilateral<int64_t, false>(
        q, key_value_ptr, (int64_t**)page_buffer_ptrs, slot_mapping_ptr,
        num_qwords, num_tokens, num_layers, page_buffer_size, use_mla);
  } else {
    lmc::launch_load_and_reshape_multi_layer_kernel_unilateral<int64_t, true>(
        q, key_value_ptr, (int64_t**)page_buffer_ptrs, slot_mapping_ptr,
        num_qwords, num_tokens, num_layers, page_buffer_size, use_mla);
  }
}

void single_layer_kv_transfer(
    torch::Tensor& lmc_key_value_cache,
    torch::Tensor& vllm_key_value_cache,
    torch::Tensor& slot_mapping,
    const bool direction, const bool token_major,
    const bool vllm_two_major, const bool use_mla) {

  int64_t* lmc_key_value_cache_ptr =
      get_kernel_ptr<int64_t, torch::Tensor>(lmc_key_value_cache);
  int64_t* vllm_key_value_cache_ptr =
      get_kernel_ptr<int64_t, torch::Tensor>(vllm_key_value_cache);
  const int64_t* slot_mapping_ptr =
      get_kernel_ptr<const int64_t, const torch::Tensor>(slot_mapping);

  int elements_per_entry = 8 / vllm_key_value_cache.element_size();

  int num_tokens = slot_mapping.size(0);
  int num_heads;
  int head_size_in_64bit;
  int block_size;

  if (use_mla) {
    num_heads = 1;
    block_size = vllm_key_value_cache.size(1);
    head_size_in_64bit = vllm_key_value_cache.size(2) / elements_per_entry;
  } else {
    num_heads = vllm_key_value_cache.size(3);
    head_size_in_64bit = vllm_key_value_cache.size(4) / elements_per_entry;
    block_size = vllm_key_value_cache.size(2);
  }

  int lmc_stride;
  int lmc_value_offset;
  if (use_mla) {
    lmc_stride = lmc_key_value_cache.stride(0) / elements_per_entry;
    lmc_value_offset = 0;
  } else if (token_major) {
    lmc_stride = lmc_key_value_cache.stride(0) / elements_per_entry;
    lmc_value_offset = lmc_key_value_cache.stride(1) / elements_per_entry;
  } else {
    lmc_stride = lmc_key_value_cache.stride(1) / elements_per_entry;
    lmc_value_offset = lmc_key_value_cache.stride(0) / elements_per_entry;
  }

  int vllm_block_key_stride_in_64bit;
  int vllm_value_offset;
  if (use_mla) {
    vllm_block_key_stride_in_64bit =
        vllm_key_value_cache.stride(0) / elements_per_entry;
    vllm_value_offset = 0;
  } else if (vllm_two_major) {
    vllm_block_key_stride_in_64bit =
        vllm_key_value_cache.stride(1) / elements_per_entry;
    vllm_value_offset = vllm_key_value_cache.stride(0) / elements_per_entry;
  } else {
    vllm_block_key_stride_in_64bit =
        vllm_key_value_cache.stride(0) / elements_per_entry;
    vllm_value_offset = vllm_key_value_cache.stride(1) / elements_per_entry;
  }

  // Create SYCL queue (device selection may be tuned)
  sycl::queue q;
  auto device_id = lmc_key_value_cache.device().index();
  auto devices = sycl::device::get_devices(sycl::info::device_type::gpu);
  if (device_id >= 0 && device_id < static_cast<int>(devices.size())) {
      q = sycl::queue(devices[device_id]);
  } else {
      q = sycl::queue(sycl::default_selector_v);  // Use default GPU
  } 

  if (use_mla) {
    lmc::launch_single_layer_kv_transfer_kernel<int64_t, true>(
        q, lmc_key_value_cache_ptr, vllm_key_value_cache_ptr, slot_mapping_ptr,
        vllm_block_key_stride_in_64bit, vllm_value_offset, lmc_stride,
        lmc_value_offset, num_heads, head_size_in_64bit, block_size, direction,
        num_tokens);
  } else {
    lmc::launch_single_layer_kv_transfer_kernel<int64_t, false>(
        q, lmc_key_value_cache_ptr, vllm_key_value_cache_ptr, slot_mapping_ptr,
        vllm_block_key_stride_in_64bit, vllm_value_offset, lmc_stride,
        lmc_value_offset, num_heads, head_size_in_64bit, block_size, direction,
        num_tokens);
  }
}

void load_and_reshape_flash(
    torch::Tensor& key_value,
    torch::Tensor& key_cache,
    torch::Tensor& value_cache,
    torch::Tensor& slot_mapping,
    const int layer_idx) {

  int64_t* key_value_ptr = get_kernel_ptr<int64_t, torch::Tensor>(key_value);
  int64_t* key_cache_ptr = get_kernel_ptr<int64_t, torch::Tensor>(key_cache);
  int64_t* value_cache_ptr = get_kernel_ptr<int64_t, torch::Tensor>(value_cache);
  const int64_t* slot_mapping_ptr =
      get_kernel_ptr<const int64_t, const torch::Tensor>(slot_mapping);

  int elements_per_entry = 8 / key_cache.element_size();

  int num_tokens = slot_mapping.size(0);
  int num_heads = key_cache.size(2);
  int head_size_in_64bit = key_cache.size(3) / elements_per_entry;
  int block_size = key_cache.size(1);
  int key_value_stride = key_value.stride(2) / elements_per_entry;

  int num_layers = key_value.size(1);
  int key_layer_offset = layer_idx * key_value.stride(1) / elements_per_entry;
  int value_layer_offset =
      (layer_idx + num_layers) * key_value.stride(1) / elements_per_entry;

  int block_stride_in_64bit = key_cache.stride(0) / elements_per_entry;

  //  at::IntArrayRef s = key_cache.sizes();
  //  at::IntArrayRef s2 = key_value.sizes();
  //  std::cout << "Shape of key_cache: [";
  //  for (size_t i = 0; i < s.size(); ++i) {
  //      std::cout << s[i];
  //      if (i + 1 < s.size()) std::cout << ", ";
  //  }
  //std::cout << "]" << std::endl;
  //  std::cout << "Shape of key_value: [";
  //  for (size_t i = 0; i < s2.size(); ++i) {
  //      std::cout << s2[i];
  //      if (i + 1 < s2.size()) std::cout << ", ";
  //  }
  //std::cout << "]" << std::endl;

  sycl::queue q;
  auto device_id = key_value.device().index();
  auto devices = sycl::device::get_devices(sycl::info::device_type::gpu);
  if (device_id >= 0 && device_id < static_cast<int>(devices.size())) {
      q = sycl::queue(devices[device_id]);
  } else {
      q = sycl::queue(sycl::default_selector_v);  // Use default GPU
  } 

  lmc::launch_load_and_reshape_flash_kernel<int64_t>(
      q, key_value_ptr, key_cache_ptr, value_cache_ptr, slot_mapping_ptr,
      block_stride_in_64bit, key_value_stride, num_heads, head_size_in_64bit,
      block_size, key_layer_offset, value_layer_offset, num_tokens);
}

void reshape_and_cache_back_flash(
    torch::Tensor& key_value,
    torch::Tensor& key_cache,
    torch::Tensor& value_cache,
    torch::Tensor& slot_mapping,
    const int layer_idx) {

  int64_t* key_cache_ptr = get_kernel_ptr<int64_t, torch::Tensor>(key_cache);
  int64_t* value_cache_ptr = get_kernel_ptr<int64_t, torch::Tensor>(value_cache);
  int64_t* key_value_ptr = get_kernel_ptr<int64_t, torch::Tensor>(key_value);
  const int64_t* slot_mapping_ptr =
      get_kernel_ptr<const int64_t, const torch::Tensor>(slot_mapping);

  int elements_per_entry = 8 / key_cache.element_size();

  int num_tokens = slot_mapping.size(0);
  int num_heads = key_cache.size(2);
  int head_size_in_64bit = key_cache.size(3) / elements_per_entry;
  int block_size = key_cache.size(1);
  int key_value_stride = key_value.stride(2) / elements_per_entry;

  int num_layers = key_value.size(1);
  int key_layer_offset = layer_idx * key_value.stride(1) / elements_per_entry;
  int value_layer_offset =
      (layer_idx + num_layers) * key_value.stride(1) / elements_per_entry;

  int block_stride_in_64bit = key_cache.stride(0) / elements_per_entry;

  sycl::queue q;
  auto device_id = key_value.device().index();
  auto devices = sycl::device::get_devices(sycl::info::device_type::gpu);
  if (device_id >= 0 && device_id < static_cast<int>(devices.size())) {
      q = sycl::queue(devices[device_id]);
  } else {
      q = sycl::queue(sycl::default_selector_v);  // Use default GPU
  } 

  lmc::launch_reshape_and_cache_back_flash_kernel<int64_t>(
      q, key_value_ptr, key_cache_ptr, value_cache_ptr, slot_mapping_ptr,
      block_stride_in_64bit, key_value_stride, num_heads, head_size_in_64bit,
      block_size, key_layer_offset, value_layer_offset, num_tokens);
}

void single_layer_kv_transfer_sgl(
    torch::Tensor& lmc_key_value_cache,
    torch::Tensor& sgl_key_cache,
    torch::Tensor& sgl_value_cache,
    torch::Tensor& slot_mapping,
    const bool direction, const bool token_major) {

  int64_t* lmc_key_value_cache_ptr =
      get_kernel_ptr<int64_t, torch::Tensor>(lmc_key_value_cache);

  int64_t* sgl_key_cache_ptr =
      get_kernel_ptr<int64_t, torch::Tensor>(sgl_key_cache);
  int64_t* sgl_value_cache_ptr =
      get_kernel_ptr<int64_t, torch::Tensor>(sgl_value_cache);

  const int64_t* slot_mapping_ptr =
      get_kernel_ptr<const int64_t, const torch::Tensor>(slot_mapping);

  int elements_per_entry = 8 / sgl_key_cache.element_size();

  int num_tokens = slot_mapping.size(0);
  int num_heads = sgl_key_cache.size(2);
  int head_size_in_64bit = sgl_key_cache.size(3) / elements_per_entry;
  int block_size = sgl_key_cache.size(1);

  int lmc_stride;
  int lmc_value_offset;
  if (token_major) {
    lmc_stride = lmc_key_value_cache.stride(0) / elements_per_entry;
    lmc_value_offset = lmc_key_value_cache.stride(1) / elements_per_entry;
  } else {
    lmc_stride = lmc_key_value_cache.stride(1) / elements_per_entry;
    lmc_value_offset = lmc_key_value_cache.stride(0) / elements_per_entry;
  }

  int block_stride_in_64bit = sgl_key_cache.stride(0) / elements_per_entry;

  sycl::queue q;
  auto device_id = lmc_key_value_cache.device().index();
  auto devices = sycl::device::get_devices(sycl::info::device_type::gpu);
  if (device_id >= 0 && device_id < static_cast<int>(devices.size())) {
      q = sycl::queue(devices[device_id]);
  } else {
      q = sycl::queue(sycl::default_selector_v);  // Use default GPU
  } 

  lmc::launch_single_layer_kv_transfer_sgl_kernel<int64_t>(
      q, lmc_key_value_cache_ptr, sgl_key_cache_ptr, sgl_value_cache_ptr,
      slot_mapping_ptr, block_stride_in_64bit, lmc_stride, lmc_value_offset,
      num_heads, head_size_in_64bit, block_size, direction, num_tokens);
}

