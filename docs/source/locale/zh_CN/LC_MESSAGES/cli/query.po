msgstr "将 ``--api quota`` 限制为一个租户。使用 ``_default`` 处理未加盐的流量。"

#: ../../source/cli/query.rst:400
msgid "``--request-id ID``"
msgstr "``--request-id ID``"

#: ../../source/cli/query.rst:402
