msgid "``--format FORMAT``"
msgstr "``--format FORMAT``"

#: ../../source/cli/bench.rst:1004
msgid "``terminal``"
msgstr "``terminal``"

#: ../../source/cli/bench.rst:1005
msgid ""
"Stdout output format for the final metrics summary. Available: "
"``terminal``, ``json``."
msgstr "最终指标摘要的标准输出格式。可用格式：\\ ``terminal``\\ 、\\ ``json``\\ 。"

#: ../../source/cli/bench.rst:1007
msgid "``--output PATH``"
msgstr "``--output PATH``"

#: ../../source/cli/bench.rst:1009
msgid ""
"Save the final metrics summary to a file at PATH (format chosen by "
