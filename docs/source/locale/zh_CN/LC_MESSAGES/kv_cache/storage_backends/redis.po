#: ../../source/kv_cache/storage_backends/redis.rst:305
msgid ""
"LMCache stores data in Redis using a structured key format. Each key "
"contains the following information in a delimited format:"
msgstr ""
"LMCache 使用结构化键格式在 Redis 中存储数据。每个键都包含以下分隔格式的信息："

#: ../../source/kv_cache/storage_backends/redis.rst:311
msgid "`format`: The model format (e.g., \"vllm\" or \"huggingface\")"
msgstr "`format`：模型格式（例如，\"vllm\" 或 \"huggingface\"）"

#: ../../source/kv_cache/storage_backends/redis.rst:312
msgid "`model_name`: Name of the language model"
msgstr "`model_name`：语言模型的名称"

#: ../../source/kv_cache/storage_backends/redis.rst:313
msgid "`world_size`: Total number of workers in distributed deployment"
msgstr "`world_size`：分布式部署中的工作进程总数"

#: ../../source/kv_cache/storage_backends/redis.rst:314
msgid "`worker_id`: ID of the worker that created this cache entry"
msgstr "`worker_id`：创建此缓存条目的工作进程 ID"

#: ../../source/kv_cache/storage_backends/redis.rst:315
msgid "`chunk_hash`: Hash of the token chunk (SHA-256 based)"
msgstr "`chunk_hash`：令牌块的哈希值（基于 SHA-256）"

