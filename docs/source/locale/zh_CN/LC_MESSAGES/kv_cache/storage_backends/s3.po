#: ../../source/kv_cache/storage_backends/s3.rst:2
msgid "S3 Backend"
msgstr "S3 后端"

#: ../../source/kv_cache/storage_backends/s3.rst:5
msgid "Example Configurations"
msgstr "示例配置"

#: ../../source/kv_cache/storage_backends/s3.rst:8
msgid "Basic S3 Configuration"
msgstr "基本 S3 配置"

#: ../../source/kv_cache/storage_backends/s3.rst:24
msgid "S3 Express One Zone"
msgstr "S3 Express 单区域"

#: ../../source/kv_cache/storage_backends/s3.rst:43
msgid "CoreWeave (S3-compatible)"
msgstr "CoreWeave（S3 兼容）"

#: ../../source/kv_cache/storage_backends/s3.rst:64
msgid ""
"**Note**: `cwlota.com` is CoreWeave's S3-compatible Cloud Storage that "
"caches for GPU locality. Set `s3_enable_s3express: False` for non-AWS "
"services."
msgstr "**注意**：`cwlota.com` 是 CoreWeave 的 S3 兼容云存储，可为 GPU 本地性缓存。对于非 AWS 服务，设置 `s3_enable_s3express: False`。"

#: ../../source/kv_cache/storage_backends/s3.rst:67
msgid "Configuration Parameters"
msgstr "配置参数"

#: ../../source/kv_cache/storage_backends/s3.rst:69
msgid "**remote_url**: S3 bucket URL (`s3://bucket-name`)"
msgstr "**remote_url**：S3 存储桶 URL（`s3://bucket-name`）"

#: ../../source/kv_cache/storage_backends/s3.rst:70
msgid ""
"**save_unfull_chunk**: Save partial chunks (default: True, **must be "
"False for S3**)"
msgstr "**save_unfull_chunk**：保存部分块（默认：True，**对于 S3 必须为 False**）"

#: ../../source/kv_cache/storage_backends/s3.rst:71
msgid "**enable_async_loading**: Async loading (default: False)"
msgstr "**enable_async_loading**：异步加载（默认：False）"

#: ../../source/kv_cache/storage_backends/s3.rst:72
msgid "**blocking_timeout_secs**: Timeout seconds (default: 10)"
msgstr "**blocking_timeout_secs**：超时秒数（默认：10）"

#: ../../source/kv_cache/storage_backends/s3.rst:75
msgid "S3-Specific (in extra_config)"
msgstr "S3 专用（在 extra_config 中）"

#: ../../source/kv_cache/storage_backends/s3.rst:77
msgid "**s3_region**: AWS region for S3 client (required)"
msgstr "**s3_region**：S3 客户端的 AWS 区域（必需）"

#: ../../source/kv_cache/storage_backends/s3.rst:78
msgid ""
"**s3_max_io_concurrency**: Max concurrent I/O operations for event loop "
"group (controls AWS CRT threading)"
msgstr "**s3_max_io_concurrency**：事件循环组的最大并发 I/O 操作数（控制 AWS CRT 线程）"
"**s3_max_io_concurrency**：事件循环组的最大并发 I/O 操作数（控制 AWS CRT 线程）"

#: ../../source/kv_cache/storage_backends/s3.rst:79
msgid ""
"**s3_max_inflight_reqs**: Max simultaneous S3 requests (creates this many"
" /dev/shm buffers and semaphore limit)"
msgstr "**s3_max_inflight_reqs**：最大同时 S3 请求数（创建这么多 /dev/shm 缓冲区和信号量限制）"
"**s3_max_inflight_reqs**：最大同时 S3 请求数（创建这么多 /dev/shm 缓冲区和信号量限制）"

#: ../../source/kv_cache/storage_backends/s3.rst:80
msgid ""
"**s3_prefer_http2**: Enable HTTP/2 with ALPN negotiation ([\"h2\", "
"\"http/1.1\"])"
msgstr "**s3_prefer_http2**：启用带 ALPN 协商的 HTTP/2（[\"h2\", \"http/1.1\"]）"
"**s3_prefer_http2**：启用带 ALPN 协商的 HTTP/2（[\"h2\", \"http/1.1\"]）"

#: ../../source/kv_cache/storage_backends/s3.rst:81
msgid ""
"**s3_enable_s3express**: Enable S3 Express One Zone support in AWS CRT "
"client"
msgstr "**s3_enable_s3express**：在 AWS CRT 客户端中启用 S3 Express One Zone 支持"
"**s3_enable_s3express**：在 AWS CRT 客户端中启用 S3 Express One Zone 支持"

#: ../../source/kv_cache/storage_backends/s3.rst:82
msgid ""
"**s3_file_prefix**: Prefix for S3 object keys (e.g., `cache` becomes "
"`/cache/key_name`). Avoid leading/trailing slashes."
msgstr ""
"**s3_file_prefix**：S3 对象键的前缀（例如，`cache` 变为 `/cache/key_name`）。避免前导/尾随斜杠。"

#: ../../source/kv_cache/storage_backends/s3.rst:83
msgid ""
"**save_chunk_meta**: Whether to save chunk metadata with data (set False "
"for performance)"
msgstr ""
"**save_chunk_meta**：是否与数据一起保存块元数据（为性能设置为 False）"

#: ../../source/kv_cache/storage_backends/s3.rst:85
msgid ""
"The effective concurrency is limited by the minimum of "
"`s3_max_io_concurrency` and `s3_max_inflight_reqs`."
msgstr ""
"有效并发数受 `s3_max_io_concurrency` 和 `s3_max_inflight_reqs` 的最小值限制。"

#: ../../source/kv_cache/storage_backends/s3.rst:88
msgid "/dev/shm Configuration"
msgstr "/dev/shm 配置"

#: ../../source/kv_cache/storage_backends/s3.rst:90
msgid ""
"/dev/shm is used as the tmpfs that S3 can use to transfer only into RAM "
"instead of having to touch a block device."
msgstr ""
"/dev/shm 用作 tmpfs，S3 可以使用它仅传输到 RAM 中，而不必接触块设备。"

