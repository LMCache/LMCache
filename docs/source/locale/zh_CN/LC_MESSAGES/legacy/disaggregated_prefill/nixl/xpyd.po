#: ../../source/legacy/disaggregated_prefill/nixl/xpyd.rst:10
msgid "X Prefiller, Y Decoder (XpYd) Example"
msgstr ""

#: ../../source/legacy/disaggregated_prefill/nixl/xpyd.rst:12
msgid ""
"This example demonstrates how to run LMCache with disaggregated prefill "
"using NIXL on a single node with multiple prefiller and decoder "
"instances. This configuration allows for horizontal scaling of both the "
"compute-intensive prefill operations and the decode operations, enabling "
"better resource utilization and higher throughput."
msgstr ""

