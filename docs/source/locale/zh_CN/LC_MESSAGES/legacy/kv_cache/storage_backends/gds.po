#: ../../source/legacy/kv_cache/storage_backends/gds.rst:62
msgid "Disk I/O Thread Pool"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/gds.rst:64
msgid ""
"The backend uses a thread pool for parallel disk I/O. The thread pool is "
"always enabled regardless of whether GDS APIs or POSIX fallback is used, "
"so both code paths benefit from concurrent reads and writes."
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/gds.rst:68
msgid ""
"The number of worker threads is controlled by "
"``extra_config.disk_io_threads`` (default: 4). Increase this on fast NVMe"
" drives for higher parallelism. Set to ``0`` to disable the thread pool "
"entirely."
msgstr ""

