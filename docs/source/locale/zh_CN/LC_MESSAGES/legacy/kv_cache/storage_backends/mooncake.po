msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:206
msgid "``device_name``"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:207
#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:222
msgid "\"\""
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:208
msgid ""
"RDMA device specification (e.g., \"erdma_0,erdma_1\" or "
"\"mlx5_0,mlx5_1\"). Leave empty for autodetection in most setups."
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:209
msgid "``global_segment_size``"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:210
msgid "21474836480"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:211
msgid ""
"**Memory size contributed by each vLLM worker** in bytes (e.g., 20 GiB "
"recommended)"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:212
msgid "``local_buffer_size``"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:213
msgid "0"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:214
msgid ""
"Local buffer size in bytes used by Mooncake. Behavior depends on "
"``save_chunk_meta``: - When ``save_chunk_meta: False`` (recommended), "
"LMCache uses its local CPU backend for zero‑copy RDMA, so Mooncake's "
"``local_buffer_size`` can be ``0``. - When ``save_chunk_meta: True``, "
"Mooncake uses its own local buffer; set this to a proper value (e.g., "
"several GiB). - Note: Some RDMA NICs have memory registration limits; "
"registering LMCache's large CPU buffer can fail on constrained devices. "
"In those cases, consider enabling ``save_chunk_meta: True`` and sizing "
"``local_buffer_size`` instead."
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:218
msgid "``transfer_timeout``"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:219
msgid "1"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:220
msgid "Timeout for transfer operations in seconds"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:221
msgid "``storage_root_dir``"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:223
msgid "The root directory for persistence (e.g., \"/mnt/mooncake\")"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:224
msgid "``save_chunk_meta``"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:226
msgid ""
"Whether to save chunk metadata alongside data. Set to ``False`` to enable"
" the optimized zero‑copy path in LMCache."
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:227
msgid "``use_exists_sync``"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:229
msgid ""
"Use synchronous existence checks to avoid async scheduling overhead in "
"hot paths."
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:230
msgid "``mooncake_prefer_local_alloc``"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:232
msgid "Prefer allocating on the local segment when possible."
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:235
msgid ""
"**Understanding global_segment_size**: This parameter defines the amount "
"of memory each vLLM worker contributes to the distributed memory pool. "
"The total cluster memory available for KV cache storage will be: "
"``number_of_vllm_workers × global_segment_size``."
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:238
msgid ""
"Adjust this value based on your available system memory and expected "
"cache requirements."
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:241
msgid ""
"If you consistently get misses (no Mooncake hits), ensure all processes "
"use the same hashing seed: ``export PYTHONHASHSEED=0``. This keeps "
"pre‑caching keys consistent across processes."
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/mooncake.rst:244
msgid ""
"RDMA device(s) usually do not need to be specified; leaving "
"``device_name`` empty works for most deployments."
msgstr ""

