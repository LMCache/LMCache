#: ../../source/legacy/kv_cache/storage_backends/valkey.rst:59
msgid "``86400``"
msgstr ""

#: ../../source/legacy/kv_cache/storage_backends/valkey.rst:60
msgid ""
"Key TTL in seconds, applied only when ``valkey_enable_ttl`` is ``true``. "
"Must be a positive integer. If the flag is enabled but this key is "
"omitted, it defaults to ``86400`` (24 hours)."
msgstr ""

