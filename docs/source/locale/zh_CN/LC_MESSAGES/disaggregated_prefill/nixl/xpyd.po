#: ../../source/disaggregated_prefill/nixl/xpyd.rst:96
msgid "Prefiller Configuration"
msgstr "Prefiller 配置"

#: ../../source/disaggregated_prefill/nixl/xpyd.rst:98
msgid ""
"All prefillers share the same configuration via ``configs/lmcache-"
