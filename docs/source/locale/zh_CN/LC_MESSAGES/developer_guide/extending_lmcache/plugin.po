#: ../../source/developer_guide/extending_lmcache/plugin.rst:18
msgid ""
"Environment Variables: - ``LMCACHE_PLUGIN_ROLE``: Process role (e.g., "
"``SCHEDULER``, ``WORKER``) - ``LMCACHE_PLUGIN_CONFIG``: JSON string "
"containing plugin configuration - ``LMCACHE_PLUGIN_WORKER_ID``: Current "
"worker ID - ``LMCACHE_PLUGIN_WORKER_COUNT``: Total worker count in "
"cluster"
msgstr ""

