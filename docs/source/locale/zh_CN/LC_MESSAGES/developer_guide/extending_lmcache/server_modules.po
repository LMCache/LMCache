#: ../../source/developer_guide/extending_lmcache/server_modules.rst:343
msgid "``reap_stale_instances(reap_timeout_s, registration_grace_s)``"
msgstr "``reap_stale_instances(reap_timeout_s, registration_grace_s)``"

#: ../../source/developer_guide/extending_lmcache/server_modules.rst:344
msgid "``tracked_instance_count()``"
msgstr "``tracked_instance_count()``"

#: ../../source/developer_guide/extending_lmcache/server_modules.rst:345
msgid "``drop_instance_state(instance_id)``"
msgstr "``drop_instance_state(instance_id)``"

#: ../../source/developer_guide/extending_lmcache/server_modules.rst:347
msgid ""
"LMCache detects that method set when loading plugin modules and includes "
