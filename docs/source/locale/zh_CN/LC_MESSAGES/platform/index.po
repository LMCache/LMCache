msgstr ""

#: ../../source/platform/index.rst:37
msgid ""
"Install the vendor's device-plugin wheel in the same Python environment "
"as LMCache and the serving engine:"
msgstr ""

#: ../../source/platform/index.rst:44
msgid ""
"Replace ``lmcache-foo-device`` with the package name published by the "
"device vendor."
msgstr ""

#: ../../source/platform/index.rst:47
msgid ""
"Restart the LMCache and serving-engine processes after installation. "
"LMCache discovers installed ``lmcache.device_plugins`` entry points "
"automatically and selects the available backend. No LMCache source change"
" or manual registration is required."
msgstr ""

