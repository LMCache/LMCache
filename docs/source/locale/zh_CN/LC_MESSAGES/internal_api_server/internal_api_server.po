#: ../../source/internal_api_server/internal_api_server.rst:4
msgid "Configuring the Internal API Server"
msgstr "配置内部 API 服务器"

#: ../../source/internal_api_server/internal_api_server.rst:6
msgid ""
"The ``internal_api_server`` provides APIs for managing the LMCache "
"engine. Below are the configuration options and usage examples."
msgstr "``internal_api_server`` 提供用于管理 LMCache 引擎的 API。以下是配置选项和使用示例。"

#: ../../source/internal_api_server/internal_api_server.rst:9
msgid "Configuration Parameters"
msgstr "配置参数"

#: ../../source/internal_api_server/internal_api_server.rst:11
msgid "The following parameters can be configured in the YAML file:"
msgstr "可以在 YAML 文件中配置以下参数："

#: ../../source/internal_api_server/internal_api_server.rst:34
msgid "Testing the Server"
msgstr "测试服务器"

#: ../../source/internal_api_server/internal_api_server.rst:36
msgid "You can test the server by querying the relevant endpoints."
msgstr "您可以通过查询相关端点来测试服务器。"

#: ../../source/internal_api_server/internal_api_server.rst:38
