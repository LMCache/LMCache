#
# Minimal, CPU-only image for reproducing the cache-policy benchmark
# suite and evaluation report (benchmarks/cache_policy/,
# lmcache/tools/cache_policy_bench/,
# lmcache/v1/storage_backend/cache_policy/). No GPU/CUDA required for
# anything in this suite.
#
# lmcache is never `pip install`-ed (not even editable): this suite
# imports it via PYTHONPATH=/app pointing at the repo root, exactly
# like the recipe in environment.yml -- nothing here needs lmcache's
# native extensions, so the build stays simple (no compiler toolchain,
# no NO_NATIVE_EXT dance).
#
# Build (from the repository root):
#   docker build -f benchmarks/cache_policy/Dockerfile -t lmcache-cache-policy-bench .
#
# Run the deterministic-reproducibility check (fast, self-contained, no
# external data required -- this is the default command):
#   docker run --rm lmcache-cache-policy-bench
#
# Run the full benchmark suite + report figures, persisting output to
# the host (mount points match this repo's own results/report layout):
#   docker run --rm \
#       -v "$(pwd)/benchmarks/cache_policy/results:/app/benchmarks/cache_policy/results" \
#       -v "$(pwd)/benchmarks/cache_policy/report:/app/benchmarks/cache_policy/report" \
#       lmcache-cache-policy-bench bash -c "\
#           python benchmarks/cache_policy/main_sweep_multiseed.py && \
#           python benchmarks/cache_policy/run_admission_control_ablation.py && \
#           python benchmarks/cache_policy/robustness_sweep.py && \
#           python -m lmcache.tools.cache_policy_bench.runner --sweep \
#               --policies LRU LFU FIFO MRU COST_AWARE ADMISSION_LRU \
#               ADMISSION_LFU ADMISSION_FIFO ADMISSION_MRU ADMISSION_COST_AWARE \
#               WINDOWED_ADMISSION_LRU WINDOWED_ADMISSION_LFU \
#               WINDOWED_ADMISSION_FIFO WINDOWED_ADMISSION_MRU \
#               WINDOWED_ADMISSION_COST_AWARE \
#               -o benchmarks/cache_policy/results/admission_control && \
#           ./benchmarks/cache_policy/reproduce_figures.sh"
#
# The checked-in PDF report (report/cache_policy_evaluation_report.pdf)
# is the final submitted deliverable and is not regenerated by this
# image or any script in this repo -- only its figures are.
#
# The real-ShareGPT tier (real_dataset_eval.py) needs the corpus prepared
# separately first -- see benchmarks/cache_policy/README.md -- and is
# not part of the default reproducibility check since it requires a
# ~230 MB external download.

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

# Only the two requirement sets this suite actually needs at import
# time (torch, numpy, sortedcontainers, msgspec, ... transitively
# required by lmcache/v1/storage_backend/cache_policy/ and
# lmcache/tools/cache_policy_bench/), plus the *exact* pinned
# matplotlib/numpy versions in requirements-figures.txt -- pinning here
# (rather than a bare `pip install matplotlib`) is what makes figures
# rendered by this image reproducible run-to-run and machine-to-machine,
# instead of picking up whatever matplotlib happens to be latest.
COPY requirements/common.txt requirements/test.txt requirements/
COPY benchmarks/cache_policy/requirements-figures.txt benchmarks/cache_policy/requirements-figures.txt
RUN pip install --extra-index-url https://download.pytorch.org/whl/cpu \
        -r requirements/common.txt \
        -r requirements/test.txt \
        -r benchmarks/cache_policy/requirements-figures.txt

COPY . .

CMD ["python", "benchmarks/cache_policy/verify_reproducibility.py"]
